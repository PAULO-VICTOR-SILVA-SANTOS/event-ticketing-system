# Banco de dados
DATABASE_URL=postgresql://user:password@localhost:5432/event_ticketing

# Segurança / autenticação
SECRET_KEY=change-me-to-a-random-secret-value

# Mercado Pago
MP_ACCESS_TOKEN=TEST-seu-access-token
MP_PUBLIC_KEY=TEST-sua-public-key
MP_WEBHOOK_SECRET=sua-chave-secreta-webhook

# Resend (envio de e-mails)
RESEND_API_KEY=your-resend-api-key

# Portaria (check-in na entrada do evento)
PORTARIA_SECRET_KEY=sua-chave-secreta-portaria

# CORS: origem extra liberada (ex: dominio proprio em producao).
# Local dev (5500/5501) e qualquer *.railway.app ja sao liberados por padrao.
EXTRA_CORS_ORIGIN=https://seu-dominio.com
